# index.html is GENERATED by build.js from src/ (see CLAUDE.md §1). It is
# committed — Vercel serves the repo root — but it is never a source of truth.
#
# Do NOT hand-merge it. A textual merge of two rebuilt copies produces a file
# matching neither side's src/, and the next `npm run build` silently overwrites
# whatever was agreed, so the merge you resolved never existed. On a conflict:
#
#     npm run resolve      # = build.js + git add index.html
#
# That is correct regardless of which side "won", because src/ is the truth and
# the build is deterministic.
#
# linguist-generated collapses it in diffs and review UIs, so a 1.3MB regenerated
# file stops burying the src/ change it came from.
index.html linguist-generated=true
