# Database URL for PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/mydb"

# Port the API listens on (default 3001)
PORT=3001
# Supabase project whose JWTs this API accepts. Verification pulls the public
# keys from <SUPABASE_URL>/auth/v1/.well-known/jwks.json — no secret needed.
SUPABASE_URL="https://<ref>.supabase.co"

# The app's Google OAuth client. Same pair serverless/.env uses: a mailbox
# connected here and one connected by `make connect` are the same grant.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Must be registered character-for-character under "Authorized redirect URIs"
# on that OAuth client, or Google answers 400 redirect_uri_mismatch.
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3001/connections/google/callback"

# Fernet key, IDENTICAL to GMAIL_TOKEN_KEY in serverless/.env — the Python jobs
# decrypt what this API writes. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_TOKEN_KEY=

# Where the browser lands when the callback finishes. Optional: unset, the
# callback answers with JSON instead, which is enough to test it with curl.
# OAUTH_SUCCESS_REDIRECT="http://localhost:3000/settings?connected=google"
# OAUTH_FAILURE_REDIRECT="http://localhost:3000/settings?connect_failed=google"

# Origins the browser app is served from, comma-separated. Listed explicitly
# rather than `*`: this API accepts the Supabase session cookie, and a browser
# rejects a credentialed response carrying a wildcard origin.
WEB_ORIGINS="http://localhost:3000"
