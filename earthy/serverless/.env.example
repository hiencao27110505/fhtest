# Environment for the serverless functions.
#
# Copy to .env for local runs (`make run FN=...`). .env is git-ignored; this
# file is committed, so it must never contain a real secret.
#
# On GCP these are NOT set as plain environment variables. A function's
# environment is visible in the console and in `gcloud functions describe`, so
# anything secret is fed from Secret Manager with --set-secrets. The
# non-secret ones can go in --set-env-vars.

# ── Project ────────────────────────────────────────────────────────────────
# Cloud Functions injects GOOGLE_CLOUD_PROJECT at runtime; GCP_PROJECT is the
# local override. Either satisfies the code — set GCP_PROJECT locally only.
GCP_PROJECT=fhtest-502915

# ── Topics ─────────────────────────────────────────────────────────────────
# Defaults match the deployed topics; override only to point at a scratch one.
# WATCH_TOPIC must be the topic Gmail publishes to AND the one
# gmail-transaction-ingest is subscribed to — a mismatch means notifications
# arrive nowhere and nothing reports it.
# WATCH_TOPIC=gmail-events
# DOWNSTREAM_TOPIC=transaction-detected

# ── Account store ──────────────────────────────────────────────────────────
# Set DATABASE_URL and the store is Postgres; leave it unset and the in-memory
# stand-in is used instead (see GMAIL_ACCOUNTS below).
#
# Use the Supabase pooler in TRANSACTION mode, port 6543, not 5432: serverless
# opens many short-lived connections. psycopg is configured for it (prepared
# statements off), which is required — session-mode settings will misbehave.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Max pooled connections per function instance. Small on purpose: instances
# scale out, and each one holding connections adds up against the pooler.
# DB_POOL_MAX=2

# ── Secrets ────────────────────────────────────────────────────────────────
# Fernet key used to decrypt connected_accounts.refresh_token_enc. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored token unreadable and forces all users to
# reconnect. Rotating it requires re-encrypting every row.
GMAIL_TOKEN_KEY=

# The app's OAuth client — per-application, not per-user. From
# console.cloud.google.com → APIs & Services → Credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Gemini (transaction-parser) ────────────────────────────────────────────
# REQUIRED to read a template the parser has not seen before. There is no
# regex fallback: an unfamiliar template is either read by the model or
# reported as unreadable. Get a key at aistudio.google.com/apikey.
#
# A template only costs an API call ONCE. The model reads the mail and also
# proposes a reusable rule, which is stored (migration 0071) and read back
# locally from then on — so steady-state traffic makes no API calls at all.
# Unset the key and templates already learned keep working; only new ones stop.
#
# GEMINI_MODEL overrides the default (see parser/llm.py).
#
# Note this sends the email body to Google — including the amounts, which is
# what it is being asked to read. Only for templates not yet learned, and the
# follow-up call that derives the rule is sent a digit-redacted copy.
GEMINI_API_KEY=
# GEMINI_MODEL=

# ── Local only ─────────────────────────────────────────────────────────────
# Seeds the in-memory store when DATABASE_URL is unset: {email: refresh_token},
# plaintext. For local runs only — state dies with the process, so a saved
# historyId does not survive a restart. Never set this on a deployment.
# Quote it: sourcing this file into a shell otherwise strips the inner quotes
# and the JSON fails to parse.
# GMAIL_ACCOUNTS='{"you@gmail.com":"1//0e-your-refresh-token"}'

# ── Telegram (optional) ────────────────────────────────────────────────────
# Set both and transaction-parser posts a line per email it reads — useful for
# the first days after going live, when nobody is tailing Cloud Logging.
# Unset either and notifications are off; nothing else changes.
#
# Get a token from @BotFather; get the chat id by messaging your bot and
# reading https://api.telegram.org/bot<TOKEN>/getUpdates.
#
# Note this sends parsed amounts to a third party. It reports the result, not
# the email body — but it is still bank data leaving your infrastructure.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
